	                 $(obj_dir)diagon_mod.o $(obj_dir)fctsg_mod.o \
					 $(obj_dir)fgetpid.o $(obj_dir)free_mod.o \
					 $(obj_dir)gauss_mod.o $(obj_dir)hanle_mod.o \
					 $(obj_dir)ratmo_mod.o $(obj_dir)ratom_mod.o \
					 $(obj_dir)rbfield_mod.o $(obj_dir)rfudge_mod.o \
					 $(obj_dir)rinput_mod.o $(obj_dir)rmol_mod.o \
					 $(obj_dir)strength_mod.o $(obj_dir)tic_mod.o \
					 $(obj_dir)types_mod.o

$(LOWOBJ): $(obj_dir)%.o: $(src_dir)%.f90
	$(CMP) $(patsubst %.o,%.f90,$(patsubst $(obj_dir)%,$(src_dir)%,$@)) $(MFLAG) $(FITSFLAGS) $(OPT_LOW) $@

$(HIOBJ): $(obj_dir)%.o: $(src_dir)%.f90
	$(CMP) $(patsubst %.o,%.f90,$(patsubst $(obj_dir)%,$(src_dir)%,$@)) $(MFLAG) $(FITSFLAGS) $(OPT_HI) $@

$(OBJ): $(obj_dir)%.o: $(src_dir)%.f90
	$(CMP) $(patsubst %.o,%.f90,$(patsubst $(obj_dir)%,$(src_dir)%,$@)) $(MFLAG) $(FITSFLAGS) $(OPT) $@

# Object compilation
$(obj_dir)fgetpid.o:
	$(CC) -c $(src_dir)fgetpid.c -o $@
