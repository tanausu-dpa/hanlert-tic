		$(obj_dir)psf_mod.o $(obj_dir)ratmo_mod.o \
		$(obj_dir)ratom_mod.o $(obj_dir)rbarklem_mod.o \
		$(obj_dir)rbfield_mod.o $(obj_dir)rdmat_mod.o \
		$(obj_dir)regul_mod.o $(obj_dir)rfudge_mod.o \
		$(obj_dir)rinput_mod.o $(obj_dir)rf_mod.o \
		$(obj_dir)rmol_mod.o $(obj_dir)rpfa_mod.o \
		$(obj_dir)rtcoeff_mod.o $(obj_dir)rtcoeffaux_mod.o \
		$(obj_dir)rtcoeffi_mod.o $(obj_dir)rtcoeffiaux_mod.o \
		$(obj_dir)see_mod.o $(obj_dir)seeaux_mod.o \
		$(obj_dir)seei_mod.o $(obj_dir)seeiaux_mod.o \
		$(obj_dir)setmpi_mod.o $(obj_dir)solver_mod.o \
		$(obj_dir)solveri_mod.o $(obj_dir)stens_mod.o \
		$(obj_dir)strength_mod.o $(obj_dir)svd_mod.o \
		$(obj_dir)tic_mod.o $(obj_dir)w2freq_mod.o
W2 = $(obj_dir)iotic_mod.o $(obj_dir)tic_mod.o


# Main
hanlert:  $(OBJ)
	   $(CMP) -o $(EXE) $(OBJ) $(LOWOBJ) $(HIOBJ) $(COBJ) \
		         $(FITSFLAGS) $(MFLAG) $(LFLAGS)

# Clean
clean:
	$(COBJND)
	$(RM) $(OBJ)
	$(RM) $(LOWOBJ)
	$(RM) $(HIOBJ)
	$(RM) $(COBJ)
	$(RM) $(obj_dir)*.mod
	$(RM) $(EXE)

# Clean objects
clean_obj:
	$(RM) $(OBJ)
	$(RM) $(LOWOBJ)
	$(RM) $(HIOBJ)
	$(RM) $(COBJ)
	$(RM) $(obj_dir)*.mod

# Object dependences.
